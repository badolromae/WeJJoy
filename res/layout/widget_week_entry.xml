<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wk_entry_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/wk_time"
        android:layout_width="66dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:lineSpacingExtra="-2dp"
        android:text="오전 9:00"
        android:textColor="@color/widget_time_text"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wk_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="제목"
            android:textColor="@color/widget_body_text"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/wk_importance"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/widget_importance_progress" />
    </LinearLayout>

    <TextView
        android:id="@+id/wk_mood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text=""
        android:textSize="16sp" />
</LinearLayout>
