<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/month_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026년 8월"
                android:textColor="@color/widget_header_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/month_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=""
                android:textColor="@color/widget_muted_text"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_today"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="오늘"
            android:src="@drawable/ic_today"
            android:tint="@color/widget_header_muted" />

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="이전 달"
            android:src="@drawable/ic_chevron_left"
            android:tint="@color/widget_header_muted" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="다음 달"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/widget_header_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="2dp">

        <TextView style="@style/WidgetWeekday" android:text="일" android:textColor="@color/widget_day_sun" />
        <TextView style="@style/WidgetWeekday" android:text="월" />
        <TextView style="@style/WidgetWeekday" android:text="화" />
        <TextView style="@style/WidgetWeekday" android:text="수" />
        <TextView style="@style/WidgetWeekday" android:text="목" />
        <TextView style="@style/WidgetWeekday" android:text="금" />
        <TextView style="@style/WidgetWeekday" android:text="토" android:textColor="@color/widget_day_sat" />
    </LinearLayout>

    <!-- 이번 달 날짜 칸을 코드에서 채운다 (칸마다 직접 터치 동작) -->
    <LinearLayout
        android:id="@+id/month_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />
</LinearLayout>
